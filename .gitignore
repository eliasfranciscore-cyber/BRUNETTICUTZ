# Dependencias y build
node_modules
dist

# Vercel / entorno / secretos
.vercel
.env
.env*
*.local
# `vercel env pull <archivo>` no siempre escribe un nombre que empiece con
# ".env" — con --cwd, por ejemplo, deja el archivo donde le pidas y con el
# nombre que le pidas. Este patrón cubre dev.env / prod.env / cualquier.env.
*.env

# Sistema
.DS_Store

# Xcode / iOS local state
DerivedData/
*.xcuserstate
xcuserdata/

# Archivos movidos a desuso: se conservan en disco para referencia,
# pero NO se versionan ni se despliegan.
Archivos en desuso/

# graphify scratch/temp files
graphify-out/.graphify_*

# Herramientas locales de Claude Code: .claude/skills son symlinks a .agents,
# que es una biblioteca de skills de la máquina, no del proyecto.
.agents/
.claude/skills/
skills-lock.json

